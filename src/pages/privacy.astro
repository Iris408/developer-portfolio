---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.jsx";
import Footer from "../components/Footer.jsx";

// Set to the publication date, e.g. "16 October 2026", when the page goes live.
const lastUpdated = "";

const linkClass =
  "text-[var(--portfolio-ink)] underline decoration-[var(--portfolio-line)] underline-offset-4 transition hover:decoration-[var(--portfolio-accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--portfolio-accent)]";
---

<MainLayout
  title="Privacy | Ashleigh Magloire"
  description="How ashleighmagloire.com handles visitor data, including hosting, Vercel Web Analytics, fonts and email."
>
  <Navbar client:load />

  <main class="min-h-screen bg-[var(--portfolio-bg)] text-[var(--portfolio-ink)]">
    <section class="px-6 py-12 md:px-10 md:py-16 xl:px-16">
      <div class="max-w-3xl">
        <p class="text-xs font-medium uppercase tracking-[0.3em] text-[var(--portfolio-accent)]">
          Privacy
        </p>

        <h1 class="mt-5 font-serif text-4xl leading-tight md:text-5xl">
          Privacy notice
        </h1>

        {lastUpdated && (
          <p class="mt-4 text-sm text-[var(--portfolio-muted-soft)]">
            Last updated {lastUpdated}
          </p>
        )}

        <p class="mt-6 text-base leading-8 text-[var(--portfolio-muted)]">
          This is the personal portfolio of Ashleigh Magloire. There are no
          accounts or contact forms, and the site's own code does not set any
          cookies. This page explains what data is involved when you visit.
        </p>

        <div class="mt-10 space-y-8 border-t border-[var(--portfolio-line)] pt-8">
          <section aria-labelledby="hosting-title">
            <h2 id="hosting-title" class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--portfolio-accent)]">
              Hosting
            </h2>
            <p class="mt-3 text-base leading-8 text-[var(--portfolio-muted)]">
              The site is hosted by Vercel. To serve each page, Vercel receives
              technical information about your request, including your IP
              address and browser details. See <a href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer" class={linkClass}>Vercel's privacy policy</a>.
            </p>
          </section>

          <section aria-labelledby="analytics-title">
            <h2 id="analytics-title" class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--portfolio-accent)]">
              Analytics
            </h2>
            <p class="mt-3 text-base leading-8 text-[var(--portfolio-muted)]">
              I use Vercel Web Analytics to understand how the site is used.
              Vercel says it does not use third-party cookies for this. Instead,
              it identifies visitors using a hash derived from the incoming
              request, and discards the session after 24 hours. See <a href="https://vercel.com/docs/analytics/privacy-policy" target="_blank" rel="noopener noreferrer" class={linkClass}>Vercel's Web Analytics privacy documentation</a>.
            </p>
          </section>

          <section aria-labelledby="fonts-title">
            <h2 id="fonts-title" class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--portfolio-accent)]">
              Fonts
            </h2>
            <p class="mt-3 text-base leading-8 text-[var(--portfolio-muted)]">
              Fonts are loaded from Google Fonts, so your browser connects to
              Google's servers to retrieve them. See the <a href="https://fonts.google.com/faq#privacy" target="_blank" rel="noopener noreferrer" class={linkClass}>Google Fonts privacy FAQ</a>.
            </p>
          </section>

          <section aria-labelledby="email-title">
            <h2 id="email-title" class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--portfolio-accent)]">
              Email
            </h2>
            <p class="mt-3 text-base leading-8 text-[var(--portfolio-muted)]">
              You can contact me by email; the site's contact links open your
              own email app. If you email me, your email address and message are
              used to respond to you.
            </p>
          </section>

          <section aria-labelledby="storage-title">
            <h2 id="storage-title" class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--portfolio-accent)]">
              Theme preference
            </h2>
            <p class="mt-3 text-base leading-8 text-[var(--portfolio-muted)]">
              Your light or dark mode preference is saved in your browser's
              local storage (as <code>portfolio-theme</code>) so it is remembered
              on your next visit. It is stored on your device.
            </p>
          </section>

          <section aria-labelledby="links-title">
            <h2 id="links-title" class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--portfolio-accent)]">
              External links
            </h2>
            <p class="mt-3 text-base leading-8 text-[var(--portfolio-muted)]">
              Links to GitHub, LinkedIn and my project sites take you to other
              services, which have their own privacy policies.
            </p>
          </section>

          <section aria-labelledby="contact-title">
            <h2 id="contact-title" class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--portfolio-accent)]">
              Questions
            </h2>
            <p class="mt-3 text-base leading-8 text-[var(--portfolio-muted)]">
              For privacy questions, email <a href="mailto:contact@irisoak.dev" class={linkClass}>contact@irisoak.dev</a>.
            </p>
          </section>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>
